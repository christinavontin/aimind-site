 cx="309.0" cy="919.8" r="9" fill="#091944"/><circle cx="199.5" cy="531.3" r="9" fill="#091944"/><circle cx="544.9" cy="745.2" r="9" fill="#091944"/><circle cx="143.2" cy="821.3" r="9" fill="#091944"/><circle cx="389.6" cy="491.7" r="9" fill="#091944"/><circle cx="430.8" cy="903.8" r="9" fill="#091944"/><circle cx="120.1" cy="626.0" r="9" fill="#091944"/><circle cx="539.4" cy="620.9" r="11" fill="#e05a47"/><circle cx="231.8" cy="909.7" r="9" fill="#091944"/><circle cx="263.8" cy="486.4" r="9" fill="#091944"/><circle cx="527.7" cy="822.2" r="9" fill="#091944"/><circle cx="103.8" cy="752.4" r="9" fill="#091944"/><circle cx="465.6" cy="516.1" r="11" fill="#e05a47"/><circle cx="357.8" cy="937.2" r="9" fill="#091944"/><circle cx="151.7" cy="551.7" r="9" fill="#091944"/><circle cx="566.4" cy="697.5" r="9" fill="#091944"/><circle cx="159.8" cy="871.1" r="9" fill="#091944"/><circle cx="343.4" cy="466.2" r="9" fill="#091944"/><circle cx="482.2" cy="891.1" r="9" fill="#091944"/><circle cx="90.7" cy="670.4" r="9" fill="#091944"/><circle cx="530.8" cy="568.2" r="11" fill="#e05a47"/><circle cx="274.1" cy="942.8" r="9" fill="#091944"/><circle cx="210.0" cy="490.7" r="9" fill="#091944"/><circle cx="564.4" cy="782.3" r="9" fill="#091944"/><circle cx="103.8" cy="806.9" r="9" fill="#091944"/><circle cx="428.5" cy="475.9" r="11" fill="#e05a47"/></svg>
    <div class="mk-blocks">
      <div class="mk-b in"><p class="mk-n">{t.in.n}</p><p class="mk-t">{t.in.t}</p><p class="mk-p">{t.in.p}</p></div>
      <div class="mk-b"><p class="mk-n">{t.out.n}</p><p class="mk-t">{t.out.t}</p><p class="mk-p">{t.out.p}</p><ul>{t.out.li.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </div>
  <figcaption class="mk-cap">{t.caption}</figcaption>
</figure>

<style>
  .mk { margin: 48px 0; background: var(--offwhite); border-radius: 16px; padding: clamp(24px, 4vw, 40px); }
  .mk > .kick { margin-top: 0; margin-bottom: 10px; }
  .mk-title { margin: 0 0 10px; font-family: var(--font-serif); font-weight: 400; font-size: clamp(24px, 3vw, 30px); line-height: 1.2; letter-spacing: -0.01em; color: var(--navy); }
  .mk-sub { margin: 0 0 24px; font-size: 17px; line-height: 1.45; color: var(--navy); }
  .mk-body { display: grid; grid-template-columns: minmax(0, 44%) 1fr; gap: 28px; align-items: center; }
  .mk-dots { width: 100%; height: auto; display: block; }
  .mk-dots circle:first-child { fill: #fff; opacity: 1; }
  .mk-b { padding-left: 20px; border-left: 2px solid var(--line-step); }
  .mk-b + .mk-b { margin-top: 24px; }
  .mk-b.in { border-left-color: var(--coral); }
  .mk-b p { margin: 0; }
  .mk-n { font-family: var(--font-serif); font-size: clamp(40px, 5vw, 52px); line-height: 1; letter-spacing: -0.02em; color: var(--navy); }
  .mk-b.in .mk-n { color: var(--coral); }
  .mk-t { margin-top: 6px !important; font-size: 17px; font-weight: 600; color: var(--navy); }
  .mk-p { margin-top: 6px !important; font-size: 16px; line-height: 1.45; color: var(--navy); }
  .mk-b ul { list-style: none; margin: 8px 0 0; padding: 0; }
  .mk-b li { position: relative; padding-left: 16px; margin: 0 0 4px; font-size: 15px; line-height: 1.4; color: var(--slate); }
  .mk-b li::before { content: ''; position: absolute; left: 0; top: .65em; width: 7px; height: 2px; background: var(--cyan); }
  .mk-cap { margin-top: 24px; font-size: 14px; line-height: 1.5; color: var(--slate); }
  @media (max-width: 640px) {
    .mk-body { grid-template-columns: 1fr; }
    .mk-dots { max-width: 300px; margin: 0 auto; }
  }
</style>
