---
// Article illustration for the ROI hub, EN and DE: of 100 buyers, about 5 are in the market in any given quarter.
// Built in HTML so the text stays readable for search and AI; same content as the LinkedIn infographic roi-market.
// Design rules: private brand guide, section "Infographics" → "On the website".
interface Props { lang: 'en' | 'de' }
const { lang } = Astro.props;

const t = {
  de: {
    kick: 'Marketing-ROI im Projektgeschäft',
    title: 'Wer nur Leads misst, sieht 5\u00a0% seines Marktes',
    sub: 'Von 100 Käufern sind in einem Quartal rund 5 im Markt.',
    in: { n: '5\u00a0%', t: 'sind im Markt', p: 'Marketing wandelt Nachfrage in Umsatz um. Den Beitrag belegen die marketingbeeinflusste Pipeline und der marketingbeeinflusste Umsatz im CRM.' },
    out: { n: '95\u00a0%', t: 'kaufen gerade nicht', p: 'Marketing schafft Nachfrage. Ob das gelingt, zeigen:', li: ['Besuche der Zielunternehmen', 'Sichtbarkeit in KI-Antworten', 'Anfragen und Ausschreibungen ohne Kampagne', 'die Antwort neuer Kunden, wie sie auf das Unternehmen gestoßen sind'] },
    alt: '100 Punkte stehen für die Käufer in einem Markt, 5 davon sind hervorgehoben.',
    caption: 'Quelle: John Dawes, Ehrenberg-Bass Institute',
  },
  en: {
    kick: 'Marketing ROI in complex sales',
    title: 'Measure Only Leads, and You See 5% of Your Market',
    sub: 'Of 100 buyers, about 5 are in the market in any given quarter.',
    in: { n: '5%', t: 'are in the market', p: 'Marketing converts demand into revenue. Marketing-influenced pipeline and revenue in the CRM prove the contribution.' },
    out: { n: '95%', t: 'aren\u2019t buying right now', p: 'Marketing creates demand. The signs that it works:', li: ['Visits from target accounts', 'Visibility in AI answers', 'Inquiries and requests for proposals that arrive without a campaign', 'How new customers found the company'] },
    alt: '100 dots stand for the buyers in a market, 5 of them highlighted.',
    caption: 'Source: John Dawes, Ehrenberg-Bass Institute',
  },
}[lang];
---
<figure class="mk" aria-labelledby={`mk-title-${lang}`}>
  <p class="kick">{t.kick}</p>
  <h4 id={`mk-title-${lang}`} class="mk-title">{t.title}</h4>
  <p class="mk-sub">{t.sub}</p>
  <div class="mk-body">
    <svg class="mk-dots" viewBox="50 425 560 560" role="img" aria-label={t.alt}><circle cx="330" cy="705" r="276" fill="#ffeaa7" opacity=".55"/><circle cx="347.7" cy="705.0" r="9" fill="#091944"/><circle cx="307.4" cy="725.7" r="9" fill="#091944"/><circle cx="333.5" cy="665.6" r="9" fill="#091944"/><circle cx="358.5" cy="742.1" r="9" fill="#091944"/><circle cx="277.8" cy="695.8" r="9" fill="#091944"/><circle cx="379.5" cy="673.5" r="9" fill="#091944"/><circle cx="313.5" cy="766.6" r="9" fill="#091944"/><circle cx="298.4" cy="644.2" r="9" fill="#091944"/><circle cx="398.5" cy="730.0" r="9" fill="#091944"/><circle cx="258.8" cy="734.4" r="9" fill="#091944"/><circle cx="364.3" cy="631.6" r="9" fill="#091944"/><circle cx="355.4" cy="785.9" r="9" fill="#091944"/><circle cx="253.5" cy="660.7" r="9" fill="#091944"/><circle cx="419.7" cy="685.3" r="9" fill="#091944"/><circle cx="275.2" cy="782.9" r="9" fill="#091944"/><circle cx="317.4" cy="607.4" r="9" fill="#091944"/><circle cx="407.7" cy="770.4" r="9" fill="#091944"/><circle cx="225.5" cy="709.3" r="9" fill="#091944"/><circle cx="406.2" cy="629.2" r="9" fill="#091944"/><circle cx="324.9" cy="815.3" r="9" fill="#091944"/><circle cx="257.5" cy="618.1" r="9" fill="#091944"/><circle cx="444.9" cy="720.5" r="9" fill="#091944"/><circle cx="232.7" cy="772.7" r="9" fill="#091944"/><circle cx="356.6" cy="586.8" r="9" fill="#091944"/><circle cx="391.5" cy="812.4" r="9" fill="#091944"/><circle cx="209.7" cy="666.6" r="9" fill="#091944"/><circle cx="446.8" cy="651.0" r="9" fill="#091944"/><circle cx="279.4" cy="825.9" r="9" fill="#091944"/><circle cx="284.8" cy="579.4" r="9" fill="#091944"/><circle cx="450.2" cy="768.2" r="9" fill="#091944"/><circle cx="196.5" cy="740.2" r="9" fill="#091944"/><circle cx="405.9" cy="587.0" r="9" fill="#091944"/><circle cx="354.1" cy="845.5" r="9" fill="#091944"/><circle cx="215.6" cy="616.4" r="9" fill="#091944"/><circle cx="476.3" cy="692.9" r="9" fill="#091944"/><circle cx="228.8" cy="814.3" r="9" 