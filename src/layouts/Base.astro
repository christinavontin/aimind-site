---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE, UI, abs, type Lang } from '../lib/site';

interface Alternate { lang: Lang; href: string }
interface Props {
  lang: Lang;
  seoTitle: string;
  description: string;
  permalink: string;
  alternates?: Alternate[]; // EN/DE versions of this page, including itself
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  hideCtaBar?: boolean; // phones: the contact page needs no booking bar
}

const { lang, seoTitle, description, permalink, alternates = [], image, imageAlt, ogType = 'website', jsonLd = [], noindex = false, hideCtaBar = false } = Astro.props;
const t = UI[lang];
const canonical = abs(permalink);
const ogImage = abs(image ?? SITE.defaultImage);
const en = alternates.find((a) => a.lang === 'en');
const other = alternates.find((a) => a.lang !== lang);
const enHref = lang === 'en' ? permalink : (other?.href ?? '/');
const deHref = lang === 'de' ? permalink : (other?.href ?? '/de/');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seoTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={UI[a.lang].htmlLang.slice(0, 2)} href={abs(a.href)} />)}
    {en && <link rel="alternate" hreflang="x-default" href={abs(en.href)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt' : 'Skip to content'}</a>
    <header class="site">
      <div class="wrap header-inner">
        <a class="brand" href={t.home} aria-label={`${SITE.name} – ${t.tagline}`}><Logo id="lg-h" /></a>
        <nav class="navlinks" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
          {t.nav.map((item) => <a class="nl" href={item.href}>{item.label}</a>)}
          <span class="langs">
            {lang === 'en' ? <span aria-current="true">EN</span> : <a class="nl" href={enHref} hreflang="en" lang="en">EN</a>}
            <span aria-hidden="true">/</span>
            {lang === 'de' ? <span aria-current="true">DE</span> : <a class="nl" href={deHref} hreflang="de" lang="de">DE</a>}
          </span>
          <a href={t.cta.href} class="btn sm">{t.cta.label}</a>
        </nav>
        <div class="mbar">
          <span class="langs">
            {lang === 'en' ? <span aria-current="true">EN</span> : <a class="nl" href={enHref} hreflang="en" lang="en">EN</a>}
            <span aria-hidden="true">/</span>
            {lang === 'de' ? <span aria-current="true">DE</span> : <a class="nl" href={deHref} hreflang="de" lang="de">DE</a>}
          </span>
          <details class="mmenu">
            <summary class="menu" aria-label={t.menu}><span class="chev"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#091944" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" /></svg></span></summary>
            <nav class="mpanel" aria-label={lang === 'de' ? 'Menü' : 'Menu'}>
              {t.nav.map((item) => <a class="nl" href={item.href}>{item.label}</a>)}
            </nav>
          </details>
        </div>
      </div>
      <span class="prog" aria-hidden="true"></span>
    </header>
    <main id="main">
      <slot />
    </main>
    {!hideCtaBar && <div class="ctabar"><a href={t.cta.href} class="btn sm">{t.cta.label}</a></div>}
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span class="footer-brand">
          <Logo size="footer" id="lg-f" />
          <span>© {year} {SITE.author} · {t.license} <a class="nl" href="https://creativecommons.org/licenses/by-nc/4.0/" rel="license noopener" target="_blank">CC BY-NC 4.0</a></span>
        </span>
        <span class="footer-links">
          {t.footer.map((item) => <a class="nl" href={item.href}>{item.label}</a>)}
          <a class="nl" href={lang === 'en' ? deHref : enHref} hreflang={lang === 'en' ? 'de' : 'en'}>{t.switchTo}</a>
        </span>
      </div>
    </footer>
  </body>
</html>
