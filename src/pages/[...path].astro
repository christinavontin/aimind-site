---
// Renders every article and page at its permalink, e.g.
// /2025/07/31/challenges-for-b2b-cmo/ and /de/2025/07/31/challenges-for-b2b-cmo/
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { SITE, UI, abs, formatDate, type Lang } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (e) => !e.data.draft);
  const pages = await getCollection('pages', (e) => !e.data.draft);
  const all = [...posts.map((e) => ({ kind: 'post' as const, entry: e })), ...pages.map((e) => ({ kind: 'page' as const, entry: e }))];
  return all
    .filter(({ entry }) => entry.data.permalink !== '/' && entry.data.permalink !== '/de/')
    .map(({ kind, entry }) => {
      const siblings = all
        .filter((o) => o.entry.data.key === entry.data.key && o.kind === kind)
        .map((o) => ({ lang: o.entry.data.lang as Lang, href: o.entry.data.permalink }));
      return {
        params: { path: entry.data.permalink.replace(/^\/|\/$/g, '') },
        props: { kind, entry, alternates: siblings },
      };
    });
}

const { kind, entry, alternates } = Astro.props as any;
const d = entry.data;
const lang: Lang = d.lang;
const t = UI[lang];
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const words = (entry.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));
const readLabel = lang === 'de' ? `${minutes} Min. Lesezeit` : `${minutes} min read`;
const kicker = lang === 'de' ? 'Leitfaden' : 'Guide';

const url = abs(d.permalink);
const homeUrl = abs(t.home);
const faq = (d.faq ?? []).map((f: { q: string; a: string }) => ({ q: f.q, html: marked.parseInline(f.a) as string }));

const jsonLd: object[] = [];
if (kind === 'post') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    inLanguage: t.htmlLang,
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    mainEntityOfPage: url,
    url,
    image: d.socialImage ?? d.image ? abs(d.socialImage ?? d.image) : undefined,
    author: { '@type': 'Person', name: SITE.author, url: abs(lang === 'de' ? '/de/b2b-marketing-experience/' : '/b2b-marketing-experience/') },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: abs(SITE.logo) } },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  });
  if (faq.length) {
    jsonLd.push({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: t.htmlLang,
      mainEntity: faq.map((f: { q: string; html: string }) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.html },
      })),
    });
  }
}
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: d.title, item: url },
  ],
});
---
<Base
  lang={lang}
  seoTitle={d.seoTitle}
  description={d.description}
  permalink={d.permalink}
  alternates={alternates}
  image={d.socialImage ?? d.image}
  imageAlt={d.socialImageAlt ?? d.imageAlt}
  ogType={kind === 'post' ? 'article' : 'website'}
  jsonLd={jsonLd}
>
  {kind === 'post' ? (
    <>
      <section class="a-head">
        <div class="inner">
          <p class="kick">{kicker}</p>
          <h1>{d.title}</h1>
          <p class="a-meta"><strong>{SITE.author}</strong> · {t.updated} <time datetime={d.updated.toISOString()}>{formatDate(d.updated, lang)}</time> · {readLabel}</p>
        </div>
      </section>
      <div class="a-body">
        {toc.length > 2 && (
          <aside class="toc" aria-label={t.toc}>
            <p>{t.toc}</p>
            <ol>
              {toc.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              {faq.length > 0 && <li><a href="#faq">{t.faq}</a></li>}
            </ol>
          </aside>
        )}
        <article class="article">
          {d.image && (
            <figure class="article-hero">
              <img src={d.image} alt={d.imageAlt ?? ''} width="1200" height="675" fetchpriority="high" />
            </figure>
          )}
          <div class="prose"><Content /></div>

          {faq.length > 0 && (
            <section class="faq" aria-labelledby="faq">
              <h2 id="faq">{t.faq}</h2>
              {faq.map((f: { q: string; html: string }, i: number) => (
                <details open={i === 0}>
                  <summary>{f.q}<span class="chev"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="#091944" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg></span></summary>
                  <p set:html={f.html} />
                </details>
              ))}
            </section>
          )}

          <section class="author">
            <p class="name">{SITE.author}</p>
            <p>{t.authorBio}</p>
            <a href={t.cta.href} class="btn" style="font-size: 15px">{t.cta.label}</a>
          </section>

          {d.sources?.length > 0 && (
            <section class="sources" aria-labelledby="sources">
              <h2 id="sources">{t.sources}</h2>
              <ul>
                {d.sources.map((s: { author: string; title: string; url?: string; meta?: string }) => (
                  <li>{s.author}: {s.url ? <a href={s.url}>{s.title}</a> : s.title}{s.meta && `, ${s.meta}`}</li>
                ))}
              </ul>
            </section>
          )}
        </article>
      </div>
    </>
  ) : (
    <>
      <section class="a-head"><div class="inner"><h1>{d.title}</h1></div></section>
      <div class="a-body page-body"><article class="article"><div class="prose page-prose"><Content /></div></article></div>
    </>
  )}
</Base>
